# 形式だけの例。Kustomize の resources には含めない。
# 実際の値はリポジトリ外で管理し、Secret 管理ツールなどで登録する。
apiVersion: v1
kind: Secret
metadata:
  name: fpm-secrets
type: Opaque
stringData:
  SESSION_SECRET: ""
  SOLIDTIME_API_TOKEN: ""
  # OIDC の client secret を使う場合だけ必要。
  OIDC_CLIENT_SECRET: ""
  # PostgreSQL の場合だけ必要。
  DATABASE_URL: ""
