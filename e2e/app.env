NODE_ENV=production
PORT=3000
TIME_ZONE=Asia/Tokyo
FORECAST_WEEKS=8
FORECAST_MONTHS=3
SYNC_INTERVAL_MINUTES=35791
DB_KIND=sqlite
SQLITE_PATH=/data/fpm.sqlite
STATIC_DIR=/app/web/dist
SOLIDTIME_BASE_URL=http://solidtime:8081
SOLIDTIME_ORGANIZATION_ID=e2e-org
SOLIDTIME_API_TOKEN=e2e-solidtime-token
GOOGLE_CALENDAR_ID=calendar@example.com
GOOGLE_DRIVE_ID=e2e-drive
GOOGLE_DRIVE_ROOT_FOLDER_ID=e2e-root
GOOGLE_CLOUD_PROJECT=e2e-project
GOOGLE_APPLICATION_CREDENTIALS=/app/e2e/google-credentials.json
OIDC_ISSUER=http://oidc:8080/e2e
OIDC_CLIENT_ID=e2e-client
OIDC_CLIENT_SECRET=e2e-client-secret
OIDC_REDIRECT_URI=http://localhost:3000/auth/callback
ALLOWED_SUB=e2e-user
SESSION_SECRET=e2e-only-session-secret-00000000
SESSION_TTL_SECONDS=43200
SECURE_COOKIES=false
