# コピー先は .env。秘密の値は空欄なので、起動前に手元で設定する。
# Docker / Compose の例。Kubernetes の設定は deploy/kubernetes を参照。

# Node の実行モード。コンテナでは production。
NODE_ENV=production
# HTTP ポート (1〜65535)。Compose のホスト側ポートもこの値になる。
PORT=3000
# 日付の集計に使う IANA タイムゾーン。既定値: Asia/Tokyo。
TIME_ZONE=Asia/Tokyo
# 予測に使う過去の週数 (1〜52、既定値: 8)。
FORECAST_WEEKS=8
# 何か月先まで予測するか (1〜24、既定値: 3)。
FORECAST_MONTHS=3
# 自動同期の間隔、分 (1〜35791、既定値: 1440)。起動直後にも同期する。
SYNC_INTERVAL_MINUTES=1440

# 必須。sqlite または postgres。
DB_KIND=sqlite
# sqlite のとき必須。コンテナの永続ボリューム内に置く。
SQLITE_PATH=/data/fpm.sqlite
# postgres のとき必須。接続パスワードを含むので空欄。SQLite では使わない。
# 形式: postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=

# 必須。solidtime のサーバー URL。/api/v1 はアプリが付ける。
SOLIDTIME_BASE_URL=https://solidtime.example.com
# 必須。solidtime の組織 ID (ダミー)。
SOLIDTIME_ORGANIZATION_ID=00000000-0000-4000-8000-000000000001
# 必須。solidtime の personal access token。
SOLIDTIME_API_TOKEN=
# 任意。取り込むメンバーの ID。空ならアプリが自分のメンバー ID を取得する。
SOLIDTIME_MEMBER_ID=

# 必須。サービスアカウントに共有したカレンダーの ID (ダミー)。
GOOGLE_CALENDAR_ID=calendar-id@group.calendar.google.com
# 必須。サービスアカウントをメンバーに加えた共有ドライブの ID (ダミー)。
GOOGLE_DRIVE_ID=example-shared-drive-id
# 必須。その共有ドライブ内で案件フォルダーを作る親フォルダーの ID (ダミー)。
GOOGLE_DRIVE_ROOT_FOLDER_ID=example-root-folder-id
# ADC が読む JSON のコンテナ内パス。JSON キーまたは WIF credential configuration。
# Compose は ./secrets/google-credentials.json をここへ読み取り専用でマウントする。
# WIF では必須。プロジェクト ID の自動探索を避けるため明示する。
GOOGLE_CLOUD_PROJECT=example-project-id
GOOGLE_APPLICATION_CREDENTIALS=/var/run/secrets/google/credentials.json

# 必須。IdP の issuer URL (ダミー)。discovery の取得に使うので HTTPS で到達できること。
OIDC_ISSUER=https://idp.example.com
# 必須。IdP に登録したクライアント ID (ダミー)。
OIDC_CLIENT_ID=fpm-example
# 次の 2 つは、どちらか片方だけを設定する。
# client_secret_basic を使う場合の client secret。
OIDC_CLIENT_SECRET=
# WIF の場合、IdP に渡す JWT が入ったファイルのコンテナ内パス。
# Kubernetes の例: /var/run/secrets/oidc/token。Compose では別途マウントが必要。
OIDC_CLIENT_ASSERTION_FILE=
# 必須。IdP に登録する戻り先 URL。パスは /auth/callback。
OIDC_REDIRECT_URI=http://localhost:3000/auth/callback
# 次の 2 つは少なくとも片方を設定。両方あると、どちらかの一致でログインできる。
# 許可するメールアドレス (ダミー)。IdP の email_verified=true も必要。
ALLOWED_EMAIL=owner@example.com
# 許可する IdP の sub。空欄ならメールアドレスで照合する。
ALLOWED_SUB=

# 必須。Cookie の署名鍵。32 文字以上の十分にランダムな値を別途設定する。
SESSION_SECRET=
# セッションの有効期間、秒 (1〜34560000、既定値: 43200 = 12 時間)。
SESSION_TTL_SECONDS=43200
# true / false。アプリの既定値は true。
# この例は localhost の HTTP 用に false。HTTPS で公開するときは必ず true に戻す。
SECURE_COOKIES=false
# Web のビルド結果の場所。空なら静的配信しない。Docker イメージではこの値を使う。
STATIC_DIR=/app/web/dist
